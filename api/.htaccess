# -----------------------------------------------------------------------------
# .htaccess racine de l'API
#
# Fonctionne dans les deux configurations du multisite OVH :
#  - dossier racine = api/public (recommandé) : ce fichier n'est pas lu ;
#  - dossier racine = api/ : tout est redirigé vers public/, et le reste
#    (config.php, vendor/, src/, sql/, var/…) est inaccessible.
# -----------------------------------------------------------------------------

# Pas de listing des dossiers.
Options -Indexes

# Fichiers cachés (.htaccess, .ovhconfig, .git…) et fichiers sensibles, dont les logs et leur
# archive (api.log, api.log.1, api.log.lock), dans tous les dossiers.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(^config(\.example)?\.php|^composer\.(json|lock)|\.(sql|md|log(\.[0-9]+)?|ini|env|lock|dist|bak|sw[op])|~)$">
    Require all denied
</FilesMatch>

# Dossiers internes : 404, même si mod_rewrite était désactivé.
RedirectMatch 404 (^|/)(vendor|src|sql|var|bin|templates|tests)(/|$)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS obligatoire : une page demandée en http:// est redirigée vers https:// (301).
    # Même règle que public/.htaccess (voir ses commentaires) : le port 80 est le signe fiable
    # chez OVH ; POST, DELETE… et X-Forwarded-Proto: https sont laissés à PHP.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{SERVER_PORT} =80 [OR]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Transmet l'en-tête « Authorization: Bearer … » du relais à PHP (voir public/.htaccess).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Seul public/ est servi : la requête /v1/messages est traitée par public/index.php.
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
