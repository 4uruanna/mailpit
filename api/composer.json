{
    "name": "amnesic/mailpit-webhook-api",
    "description": "API recevant les webhooks Mailpit (nouveaux messages) et les enregistrant en MySQL.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    }
}
