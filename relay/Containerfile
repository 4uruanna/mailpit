# Image du relais Mailpit → API.
#   sudo podman build --pull -t localhost/mailpit-relay:latest .
FROM docker.io/library/php:8.5-cli-alpine

# pcntl : signaux (webhook reçu = SIGUSR1, arrêt propre = SIGTERM envoyé par podman stop).
# memory_limit : une pièce jointe (5 Mo) ou un mail brut (25 Mo) est gardé en mémoire le temps de l'envoi.
RUN docker-php-ext-install pcntl >/dev/null \
 && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
 && printf 'memory_limit = 256M\n' > "$PHP_INI_DIR/conf.d/relay.ini"

COPY bin/ /app/bin/
COPY public/ /app/public/
COPY src/ /app/src/

# Le récepteur peut traiter 2 requêtes en même temps.
ENV PHP_CLI_SERVER_WORKERS=2

# Aucun volume : le relais n'enregistre rien (le conteneur peut tourner en lecture seule).
USER www-data
EXPOSE 8080

# Signal envoyé par « podman stop » (intercepté par bin/relay.php).
STOPSIGNAL SIGTERM

ENTRYPOINT ["php", "/app/bin/relay.php"]
