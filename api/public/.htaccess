# Contrôleur frontal Slim : toute URL qui n'est pas un fichier réel est envoyée à index.php.

Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always unset X-Powered-By
    # HSTS : le navigateur n'essaiera plus http:// pendant un an. Uniquement sur les réponses
    # HTTPS (même règle que la redirection ci-dessous). PHP l'ajoute aussi (force_https).
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{SERVER_PORT} == '443' || (%{HTTPS} == 'on' && %{SERVER_PORT} != '80')"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS obligatoire : une page demandée en http:// est redirigée vers https://, même URL (301).
    # Chez OVH, %{HTTPS} n'est pas toujours fixé derrière leur frontal : le port est le signe fiable
    # (80 = HTTP). Sans « on » ni port 443 (autre hébergeur), la requête est aussi en clair.
    # Les autres méthodes (POST, DELETE…) vont à PHP, qui les refuse (403) sans lire leur corps :
    # une redirection les ferait renvoyer en clair, ou changer en GET.
    # Un X-Forwarded-Proto: https (proxy ou CDN devant l'API) laisse décider PHP, qui ne le croit
    # que s'il vient de proxy.trusted_proxies : pas de boucle de redirection derrière un proxy.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{SERVER_PORT} =80 [OR]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Transmet l'en-tête « Authorization: Bearer … » du relais à PHP
    # (Apache + PHP-FPM le retire sinon, comme sur les hébergements OVH).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
