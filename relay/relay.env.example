# Configuration du relais Mailpit → API.
# À copier dans /etc/mailpit/relay.env (chmod 600 : contient des secrets).
# Pas de guillemets autour des valeurs.

# Adresse de base de l'API (sans « /v1/messages » ni « ?token=… » : le jeton va dans RELAY_API_TOKEN).
# Le relais appelle POST {RELAY_API_URL}/v1/messages puis POST {RELAY_API_URL}/v1/messages/{id}/part/{partId},
# et POST {RELAY_API_URL}/v1/health toutes les 30 secondes (ping de santé).
# En https:// obligatoirement : http:// n'est accepté que vers localhost, 127.0.0.1 ou ::1 (tests).
RELAY_API_URL=https://api.mondomaine.fr

# Jeton partagé avec l'API : MÊME valeur que « webhook.token » dans son config.php.
# Envoyé dans l'en-tête « Authorization: Bearer … ». Générez-le avec : openssl rand -hex 32
RELAY_API_TOKEN=REMPLACEZ_PAR_LE_RESULTAT_DE_openssl_rand_-hex_32

# Mailpit, vu depuis le conteneur du relais (nom du conteneur sur le réseau « mailpit »)
RELAY_MAILPIT_URL=http://mailpit:8025

# Identifiants de MP_UI_AUTH (voir /etc/mailpit/mailpit.env)
RELAY_MAILPIT_AUTH=admin:MotDePasseSolide

# Intervalle entre deux recherches de mails à relayer (secondes). Le webhook de Mailpit
# déclenche une recherche immédiate ; celle-ci rattrape tout mail qui n'aurait pas été vu.
#RELAY_POLL_INTERVAL=30

# Mails lus par recherche dans Mailpit (500 maximum). Les mails en attente sont relayés
# du plus ancien au plus récent, environ un lot par passage.
#RELAY_BATCH_SIZE=50

# Tags posés dans Mailpit : mail enregistré par l'API / mail refusé définitivement par l'API
#RELAY_TAG_DONE=relayed
#RELAY_TAG_FAILED=relay-failed

# Filtre de recherche Mailpit supplémentaire, par exemple pour ne pas renvoyer les anciens mails
# au premier démarrage : RELAY_QUERY=after:2026-11-08
#RELAY_QUERY=

# Nom de cette instance, enregistré par l'API (colonne mailpit_label)
#RELAY_LABEL=mailpit-prod

# Délai maximal d'une requête HTTP (secondes). Les requêtes du ping de santé attendent au plus 10 s.
#RELAY_TIMEOUT=60

# Ping de santé : POST {RELAY_API_URL}/v1/health toutes les N secondes, avec la latence et le nombre
# de mails en attente / refusés (page « Statut » du Dashboard de l'API). 0 = pas de ping.
# Gardez 60 au plus : la page Statut compte une coupure dès 90 secondes sans ping.
#RELAY_HEARTBEAT_INTERVAL=30

# Lire un mail via l'API de Mailpit le marque comme lu : true le remet en « non lu »
#RELAY_KEEP_UNREAD=true
