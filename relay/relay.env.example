# Configuration du relais Mailpit → API.
# À copier dans /etc/mailpit/relay.env (chmod 600 : contient des mots de passe).
# Pas de guillemets autour des valeurs.

# URL de l'API qui reçoit les mails complets (avec le jeton de webhook.token si vous l'utilisez)
RELAY_TARGET_URL=https://api.mondomaine.fr/hook/mailpit?token=LE_JETON

# Mailpit, vu depuis le conteneur du relais (nom du conteneur sur le réseau « mailpit »)
RELAY_MAILPIT_URL=http://mailpit:8025

# Identifiants de MP_UI_AUTH (voir /etc/mailpit/mailpit.env)
RELAY_MAILPIT_AUTH=admin:MotDePasseSolide

# true : joint aussi le mail brut (.eml, pièces jointes comprises), enregistré en fichier par l'API
RELAY_INCLUDE_RAW=false

# Taille maximale d'un mail brut joint (octets). Au-delà, seuls le texte et le HTML sont envoyés.
#RELAY_MAX_RAW_SIZE=5242880

# Nombre d'essais avant d'abandonner un mail (environ 2 jours avec 48 essais)
#RELAY_MAX_ATTEMPTS=48

# Délai maximal d'une requête HTTP (secondes)
#RELAY_TIMEOUT=30

# Lire un mail via l'API de Mailpit le marque comme lu : true le remet en « non lu »
#RELAY_KEEP_UNREAD=true
